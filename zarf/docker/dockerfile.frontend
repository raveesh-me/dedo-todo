# Image for the dedo-todo frontend. The build context is the repository root:
#   docker build -f zarf/docker/dockerfile.frontend \
#     --build-arg BUILD_SHA=$(git rev-parse HEAD | cut -c1-12) -t dedo-todo-frontend .
#
# BUILD_SHA pairs the frontend with the BFF built from the same commit: the
# frontend calls it at /bff/<BUILD_SHA>/. It is the first 12 characters of the
# commit, never git rev-parse --short.

# ---------- build ----------
FROM docker.io/library/node:22-alpine AS build
# Matches packageManager in frontend/package.json.
ARG PNPM_VERSION=10.34.9
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PNPM_HOME=/pnpm
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /src/frontend

# Dependencies first, so they are cached until the lockfile changes.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile

# Only the sources: never a local node_modules or dist.
COPY frontend/index.html frontend/tsconfig.json frontend/vite.config.ts ./
COPY frontend/src ./src

ARG BUILD_SHA
RUN echo "${BUILD_SHA}" | grep -Eq '^[0-9a-f]{12}$' || \
    { echo "BUILD_SHA must be 12 lowercase hex characters: git rev-parse HEAD | cut -c1-12" >&2; exit 1; }
RUN VITE_BUILD_SHA="${BUILD_SHA}" pnpm build

# ---------- runtime ----------
# Runs as uid 101 and listens on 8080; pid and temp files are in /tmp.
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
ARG BUILD_SHA
LABEL org.opencontainers.image.title="dedo-todo-frontend" \
      org.opencontainers.image.revision="${BUILD_SHA}"
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/frontend/dist /usr/share/nginx/html
EXPOSE 8080
USER 101
