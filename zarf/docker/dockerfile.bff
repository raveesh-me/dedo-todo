# Image for the backend for frontend, bff/. The build context is the
# repository root, since bff/go.mod replaces the backend's module (for its
# generated clients only) and gen/options with their directories:
#   make kind-bff-build
#
# BUILD_SHA pairs it with its frontend: the first 12 characters of the
# commit both are built from (git rev-parse HEAD | cut -c1-12).

# ---------- build ----------
FROM docker.io/library/golang:1.26.4-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build

COPY go.mod go.sum ./
COPY gen/options/go.mod gen/options/go.sum ./gen/options/
COPY bff/go.mod bff/go.sum ./bff/
RUN --mount=type=cache,target=/go/pkg/mod \
    cd bff && go mod download

COPY . .
ARG BUILD_SHA
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd bff && go build -trimpath -ldflags="-s -w -X main.buildSHA=${BUILD_SHA}" -o /out/bff .

# ---------- runtime ----------
FROM gcr.io/distroless/static-debian13:nonroot
ARG BUILD_SHA
LABEL org.opencontainers.image.title="dedo-todo-bff" \
      org.opencontainers.image.revision="${BUILD_SHA}"
COPY --from=build /out/bff /bff
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/bff"]
